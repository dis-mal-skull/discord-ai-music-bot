# Copiá este archivo a .env y completá los valores.
# NUNCA subas .env a git.

# Token del bot de Discord (Developer Portal -> tu app -> Bot -> Reset Token)
DISCORD_TOKEN=

# API key de Mistral (https://console.mistral.ai/)
MISTRAL_API_KEY=

# Modelo de Mistral
MISTRAL_MODEL=mistral-small-latest

# (Opcional) ID del servidor y del canal de música.
# Si los dejás vacíos, el canal de música será el mismo donde se pide.
GUILD_ID=
MUSIC_CHANNEL_ID=

# Carpeta de datos (memoria + diario + historial)
MEMORY_DIR=./data

# Cuántos mensajes de historial guardar por canal
MAX_HISTORY=12
